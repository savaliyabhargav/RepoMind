# Copy to .env.local (git-ignored). kaggle/start.sh writes these two for you.
# Comma-separated, priority order. Any OpenAI-compatible server works (Kaggle/Colab tunnel, Ollama, vLLM, ...).
LOCAL_LLM_ENDPOINTS=https://your-tunnel.trycloudflare.com/v1
# Bearer token the endpoint expects (blank for a plain local Ollama).
LOCAL_LLM_API_KEY=

# Optional tuning (defaults shown)
# LOCAL_LLM_MODEL=gemma4:e4b-it-qat
# LOCAL_LLM_EMBEDDING_MODEL=nomic-embed-text
# LOCAL_LLM_TIMEOUT_SECONDS=300
# LOCAL_LLM_COOLDOWN_SECONDS=30
# LOCAL_LLM_REASONING_EFFORT=none
