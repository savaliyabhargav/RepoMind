VITE_GITHUB_CLIENT_ID=Ov23liMS3rS8EhkfkIY5
# For ngrok sharing: points at the FRONTEND ngrok tunnel (port 5173).
# Must EXACTLY match the "Authorization callback URL" in your GitHub OAuth App settings.
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AUTH_SCOPE=user:email repo
# Relative path so API calls ride through whatever host serves the frontend (localhost OR ngrok),
# then Vite proxies /api -> backend:8080. Do NOT hardcode localhost here.
VITE_API_BASE_URL=/api